		"@pandacss/studio": "^1.7.1",
		"@tanstack/devtools-vite": "^0.3.11",
		"@types/better-sqlite3": "^7.6.13",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2",
		"vite": "^7.1.7",
		"vite-plugin-solid": "^2.11.10"
	}
