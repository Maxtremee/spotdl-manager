{
	"name": "spotdl-manager",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm run db:push && vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"start": "node .output/server/index.mjs",
		"prepare": "panda codegen",
		"seed": "pnpm run db:push && tsx --env-file=.env src/modules/server/db/seed.ts",
		"db:migrate": "drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push"
	},
