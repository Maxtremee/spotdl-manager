{
	"name": "spotdl-manager",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm run db:push && vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"start": "node .output/server/index.mjs",
		"prepare": "panda codegen",
		"seed": "pnpm run db:push && tsx --env-file=.env src/modules/server/db/seed.ts",
		"typecheck": "tsc --noEmit",
		"db:migrate": "drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"reset:db": "node scripts/reset-db.mjs",
		"docker:dev": "docker compose up --build",
		"docker:build": "docker compose build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f app",
		"docker:prod": "docker compose -f docker-compose.prod.yml up --build",
		"docker:prod:build": "docker compose -f docker-compose.prod.yml build",
		"docker:prod:down": "docker compose -f docker-compose.prod.yml down"
	},
	"dependencies": {
		"@ark-ui/solid": "5.30.0",
		"@t3-oss/env-core": "0.13.10",
		"@tanstack/router-plugin": "1.149.0",
		"@tanstack/solid-form": "1.27.7",
		"@tanstack/solid-router": "1.147.3",
		"@tanstack/solid-router-devtools": "1.149.0",
		"@tanstack/solid-start": "1.149.0",
		"@tanstack/zod-adapter": "1.147.3",
		"@types/nprogress": "0.2.3",
		"better-sqlite3": "12.6.0",
		"croner": "9.1.0",
		"drizzle-kit": "0.31.8",
		"drizzle-orm": "0.45.1",
		"drizzle-seed": "0.3.1",
		"lucide-solid": "0.562.0",
		"nitro": "latest",
		"node-id3": "0.2.9",
		"nprogress": "0.2.0",
		"p-limit": "7.3.0",
		"pino": "10.1.1",
		"slugify": "1.6.9",
		"solid-js": "1.9.10",
		"vite": "7.3.1",
		"zod": "4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@pandacss/dev": "1.8.0",
		"@pandacss/studio": "1.8.0",
		"@tanstack/devtools-vite": "0.4.1",
		"@types/better-sqlite3": "7.6.13",
		"pino-pretty": "13.1.3",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vite-plugin-solid": "2.11.10",
		"vite-tsconfig-paths": "6.0.4",
		"vitest": "4.0.16"
	}
}
