		"@tanstack/solid-form": "^1.0.0",
		"@tanstack/solid-router": "^1.133.20",
		"@tanstack/solid-router-devtools": "^1.133.20",
		"@tanstack/solid-start": "^1.132.25",
		"@tanstack/zod-adapter": "^1.145.7",
		"better-sqlite3": "^12.5.0",
		"croner": "^9.1.0",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"drizzle-seed": "^0.3.1",
		"lucide-solid": "^0.544.0",
		"nitro": "latest",
