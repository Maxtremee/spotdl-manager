# Development Dockerfile — Node runtime + ffmpeg (Phase 7 will add Chromium + yt-dlp)
FROM node:22-slim

# Install system dependencies and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    sqlite3 \
    # Build dependencies for native modules (better-sqlite3)
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches

# Copy all source files (needed for panda to resolve ~/theme imports)
COPY panda.config.ts tsconfig.json ./
COPY src ./src

# Install dependencies
RUN pnpm install --frozen-lockfile

# Expose development port
EXPOSE 3000

# Set environment to development
ENV NODE_ENV=development

# Start dev server with host binding for container access
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
