# Development Dockerfile with spotdl and all dependencies
FROM node:22-slim

# Install system dependencies required for spotdl and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    pipx \
    ffmpeg \
    git \
    sqlite3 \
    # Build dependencies for native modules (better-sqlite3)
    make \
    g++ \
    && ln -sf python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# Install spotdl using pipx (recommended for Python CLI apps)
RUN pipx install spotdl && pipx ensurepath

# Add pipx binaries to PATH
ENV PATH="/root/.local/bin:$PATH"

# Verify spotdl installation
RUN spotdl --version

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches

# Copy all source files (needed for panda to resolve ~/theme imports)
COPY panda.config.ts tsconfig.json ./
COPY src ./src

# Install dependencies
RUN pnpm install --frozen-lockfile

# Expose development port
EXPOSE 3000

# Set environment to development
ENV NODE_ENV=development

# Start dev server with host binding for container access
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
